# === LLM Provider API Keys ===
# At least one cloud provider required

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# === Bifrost ===

BIFROST_BASE_URL=http://localhost:4000/v1
BIFROST_MASTER_KEY=sk-seasoned-hand-dev-master-key-CHANGE-IN-PROD
BIFROST_ENCRYPTION_KEY=seasoned-hand-phase0-local-dev-key
BIFROST_MODEL_PRIMARY=claude-sonnet-4-6
BIFROST_MODEL_FALLBACK=gpt-4o
BIFROST_MODEL_LOCAL_FAST=llama3.2:3b

# === Backend ===

# Database
DATABASE_URL=sqlite:./data/seasoned-hand.db

# Redis
REDIS_URL=redis://localhost:6379

# Server
HOST=0.0.0.0
PORT=3000
WS_PATH=/ws

# Cost cap defaults (cents)
DEFAULT_SESSION_COST_CAP_CENTS=100
DEFAULT_DAILY_COST_CAP_CENTS=500

# === Frontend ===

NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# === Sandbox ===

AIO_SANDBOX_IMAGE=ghcr.io/agent-infra/sandbox:latest
SANDBOX_WORKSPACE_HOST=./data/workspaces

# === Search ===

BRAVE_API_KEY=
TAVILY_API_KEY=

# === Local LLM (Ollama) ===

OLLAMA_BASE_URL=http://host.docker.internal:11434

# === Observability ===

LOG_LEVEL=info
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === Development ===

RUST_LOG=seasoned_hand_server=debug,tower_http=debug
NODE_ENV=development
