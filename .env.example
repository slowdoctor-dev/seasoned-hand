# === LLM Provider API Keys ===
# At least one cloud provider required

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# Low-cost Chinese-model preset (config/slots.cn.example.yaml) uses these
# three instead of the keys above:
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=
DASHSCOPE_API_KEY=

# === Bifrost ===

BIFROST_BASE_URL=http://localhost:4000/v1
# Generate your own — e.g. `openssl rand -hex 32`. Never commit real values.
BIFROST_MASTER_KEY=
BIFROST_ENCRYPTION_KEY=
BIFROST_MODEL_PRIMARY=claude-sonnet-4-6
BIFROST_MODEL_FALLBACK=gpt-4o
BIFROST_MODEL_LOCAL_FAST=llama3.2:3b

# === Backend ===

# Database
DATABASE_URL=sqlite:./data/seasoned-hand.db

# Redis
REDIS_URL=redis://localhost:6379

# Server
HOST=0.0.0.0
PORT=3000
WS_PATH=/ws

# Cost cap defaults (cents)
DEFAULT_SESSION_COST_CAP_CENTS=100
DEFAULT_DAILY_COST_CAP_CENTS=500

# === UI (Dioxus, ADR-016) ===

# The UI is a unified-Rust/Dioxus wasm bundle (crates/seasoned-hand-ui). It
# resolves the API/WS origin from its own window location at runtime, so it needs
# no NEXT_PUBLIC_* build vars. For dev, run `just dev-ui` (separate `dx serve`).
#
# Issue #33: to self-host the UI from this one binary, build it (`just build-ui`)
# and point SH_UI_DIST at the bundle dir — the server then serves it as the
# router fallback (the API at /v1 + /ws still wins). Unset → API-only.
# SH_UI_DIST=target/dx/seasoned-hand-ui/release/web/public

# === Sandbox ===

AIO_SANDBOX_IMAGE=ghcr.io/agent-infra/sandbox:1.0.0.152
SANDBOX_WORKSPACE_HOST=./data/workspaces

# === Search ===

BRAVE_API_KEY=
TAVILY_API_KEY=

# === Local LLM (Ollama) ===

OLLAMA_BASE_URL=http://host.docker.internal:11434

# === Observability ===

LOG_LEVEL=info
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# === Development ===

RUST_LOG=seasoned_hand_server=debug,tower_http=debug
NODE_ENV=development

# === Phase 2 — Channel framework ===
# Webhook intake (story 2.10). Empty token = endpoint disabled (503).
SEASONED_HAND_INTAKE_TOKEN=
# Comma-separated CIDRs that bypass the SSRF default-deny on outbound
# webhook delivery / notify (architecture §9, DEBT #1). Empty = strict.
WEBHOOK_DELIVERY_ALLOWLIST=

# Email channel (story 2.11). Empty IMAP_HOST = email channel disabled.
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_POLL_INTERVAL_SECS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_SUBJECT_PREFIX=[sh]
# Comma-separated regex allow-list for inbound senders. Empty = deny-all
# (architecture §9, DEBT #4).
INTAKE_EMAIL_ALLOWED_SENDERS=

# Ntfy notify channel (story 2.12). Empty NTFY_TOPIC = ntfy disabled.
NTFY_HOST=https://ntfy.sh
NTFY_TOPIC=

# === Phase 2 — Workspace TTL cron (story 2.17, Phase 0 DEBT #16) ===
SANDBOX_CLEANUP_INTERVAL_SEC=3600
SANDBOX_TTL_COMPLETED_DAYS=30
SANDBOX_TTL_FAILED_CANCELLED_DAYS=7
SANDBOX_TTL_DRAFT_DAYS=1
# When set to "1", skip the apt+pip renderer-toolchain install during
# sandbox bootstrap. Speeds up integration tests; production leaves
# unset (DEBT #2 — Phase 4 will pre-bake the image).
SANDBOX_SKIP_RENDERER_INSTALL=

# === Phase 2 — CLI binary (story 2.21) ===
# How long `seasoned-hand task new "<brief>"` blocks waiting for the
# CLI deliverable before timing out.
CLI_INTAKE_MAX_WAIT_SECS=600

# === Phase 2 — Verifier worker (story 2.18, Phase 1 DEBT #15) ===
VERIFIER_MAX_CONCURRENCY=8

# === Phase 2 — Narrator classifier slot (story 2.20) ===
# Optional system-prompt path for the LLM-classifier narrator path.
# Missing file → narrator falls back to the templated path (DEBT #0).
NARRATOR_PROMPT_PATH=config/prompts/narrator.system.txt
VERIFIER_PROMPT_PATH=config/prompts/verifier.system.txt

# === Phase 1 — Admin rollback (story 1.13b) ===
# Empty token = admin endpoints return 503. Required for both
# `/v1/sessions/.../rollback` and `/v1/admin/sandbox/cleanup`.
SEASONED_HAND_ADMIN_TOKEN=
SEASONED_HAND_ROLLBACK_ON_VERIFIER_FAIL=false
