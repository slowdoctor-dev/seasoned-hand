{
  "$schema": "https://www.getbifrost.ai/schema",
  "version": 2,
  "encryption_key": "env.BIFROST_ENCRYPTION_KEY",
  "client": {
    "drop_excess_requests": false,
    "enable_logging": true,
    "enforce_auth_on_inference": false
  },
  "providers": {
    "anthropic": {
      "keys": [
        {
          "name": "anthropic-primary",
          "value": "env.ANTHROPIC_API_KEY",
          "models": ["agent-primary"],
          "aliases": {
            "agent-primary": "env.BIFROST_MODEL_PRIMARY"
          },
          "weight": 1.0
        }
      ]
    },
    "openai": {
      "keys": [
        {
          "name": "openai-fallback",
          "value": "env.OPENAI_API_KEY",
          "models": ["agent-primary", "agent-fallback"],
          "aliases": {
            "agent-primary": "env.BIFROST_MODEL_FALLBACK",
            "agent-fallback": "env.BIFROST_MODEL_FALLBACK"
          },
          "weight": 1.0
        }
      ]
    },
    "ollama": {
      "keys": [
        {
          "name": "ollama-local",
          "models": ["local-fast"],
          "aliases": {
            "local-fast": "env.BIFROST_MODEL_LOCAL_FAST"
          },
          "weight": 1.0,
          "ollama_key_config": {
            "url": "env.OLLAMA_BASE_URL"
          }
        }
      ]
    }
  },
  "config_store": {
    "enabled": false
  },
  "logs_store": {
    "enabled": true,
    "type": "sqlite",
    "config": {
      "path": "./logs.db"
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "logging",
      "config": {
        "disable_content_logging": true
      }
    }
  ]
}
